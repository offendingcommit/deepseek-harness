{
  "$schema": "https://turbo.build/schema.json",
  "tasks": {
    "build": {
      "dependsOn": ["//#build:lib:client"],
      "outputs": ["lib/**", "dist/**", "*.tsbuildinfo", "apps/web/dist/**", "website/.dist/**", ".vitepress/dist/**"]
    },
    "//#build:lib:host": {
      "cache": false
    },
    "//#build:lib:client": {
      "dependsOn": ["//#build:lib:host"],
      "cache": false
    },
    "//#build:web": {
      "dependsOn": ["//#build:lib:client"],
      "outputs": ["apps/web/dist/**"]
    },
    "//#typecheck:contracts-ready": {
      "dependsOn": ["//#build:lib:host"],
      "cache": false
    },
    "//#lint:contracts-ready": {
      "dependsOn": ["//#build:lib:host"],
      "cache": false
    },
    "//#lint:fix:contracts-ready": {
      "dependsOn": ["//#build:lib:host"],
      "cache": false
    },
    "//#doc-typecheck:contracts-ready": {
      "dependsOn": ["//#build:lib:host"],
      "cache": false
    },
    "bundle": {
      "outputs": ["lib/**", "!lib/types/**"]
    },
    "watch": {
      "cache": false,
      "persistent": true
    },
    "dev": {
      "cache": false,
      "persistent": true
    },
    "dev:web": {
      "cache": false,
      "persistent": true
    },
    "test": {
      "outputs": ["coverage/**"]
    },
    "test:coverage": {
      "outputs": ["coverage/**"]
    },
    "test:e2e": {
      "cache": false
    },
    "test:snapshot": {},
    "typecheck": {},
    "lint": {},
    "doc-sync": {},
    "clean": {
      "cache": false
    },
    "postinstall": {
      "cache": false
    },
    "prepack": {
      "cache": false
    }
  }
}
